{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-sub-planning",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-sub-planning-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production",
        "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "REPLACE_WITH_YOUR_ACCESS_TEAM_DOMAIN",
        "CLOUDFLARE_ACCESS_AUD": "REPLACE_WITH_YOUR_ACCESS_APPLICATION_AUD",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "school-sub-planning-production",
          "database_id": "3943c18d-cbf5-49cb-bc94-65e6a510cd4a",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
